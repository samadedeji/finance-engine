# Flask secret key (required in production)
SECRET_KEY=replace-with-a-long-random-flask-secret

# JWT secret key — must be different from SECRET_KEY
JWT_SECRET_KEY=replace-with-a-different-long-random-jwt-secret

# MySQL connection URI (required)
# Format: mysql+mysqlconnector://user:password@host/dbname
DATABASE_URL=mysql+mysqlconnector://root@localhost/finance-enginedb

# Frontend origin for CORS (default: http://localhost:5173)
FRONTEND_ORIGIN=http://localhost:5173
